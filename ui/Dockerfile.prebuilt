# Serving Plane UI — LAB image built from a pre-built dist/.
#
# WHY THIS EXISTS: on Docker Desktop's WSL2 backend, the hermetic multi-stage
# build in ./Dockerfile cannot run — `npm ci` aborts with "Exit handler never
# called!" on every node base (verified 18/20/22, slim/alpine), a sandbox bug
# unrelated to our code. The HOST toolchain builds dist/ fine, so for the DGX
# lab we build on the host (`npm run build`) and package the artifact here.
#
# ./Dockerfile remains the source of truth for GreenLake, where CI runs on a
# normal daemon. This image serves the identical dist/ + nginx.conf.
#
# Build (from ui/, after `npm run build`):
#   docker build -f Dockerfile.prebuilt -t routeforge/serving-plane-ui:0.1.0 .
FROM nginx:1.27-alpine AS serve

# Fail loudly if dist/ wasn't built on the host first, rather than shipping an
# empty site.
COPY dist /usr/share/nginx/html
RUN test -f /usr/share/nginx/html/index.html \
    || (echo "dist/ is empty — run 'npm run build' on the host first" && exit 1)

RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/serving-plane.conf
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=5 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
