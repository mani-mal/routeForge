      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RouteForge — every call, ten steps (policy first, eligible set before scoring)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="rf" value="RouteForge (self-hosted)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FBFBFB;strokeColor=#9AA0A6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#444444" vertex="1" parent="1"><mxGeometry x="300" y="160" width="460" height="1080" as="geometry"/></mxCell>
