# .env.example — copy to .env for local Langfuse. .env is gitignored.
# LANGFUSE_HOST is the server-reachable Langfuse API base. It is read by BOTH the
# shared trace exporter and the per-app project provisioner (below). On the DGX it
# is the in-cluster service http://langfuse-web:3000.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local          # shared/default PROJECT key pair (trace export)
LANGFUSE_SECRET_KEY=sk-lf-local

# --- Per-app Langfuse project provisioning (optional) ------------------------
# When set, onboarding an application (POST /admin/applications) auto-creates a
# dedicated Langfuse PROJECT for it and mints per-app project keys, so that app's
# traces land in its own project instead of the shared one. See
# docs/guides/langfuse-per-app-projects.md.
#
# These are ORGANIZATION-scoped keys (distinct from the project keys above),
# created in Langfuse -> Organization -> Settings -> API Keys. Absent -> the
# provisioner no-ops and every app shares the default project (still works).
# NOTE: on self-hosted Langfuse, org-scoped keys / project creation are an
# ENTERPRISE-EDITION feature (set LANGFUSE_EE_LICENSE_KEY). On OSS Langfuse use
# the manual per-app path (PUT /admin/applications/{id}/langfuse) instead.
# See docs/guides/langfuse-per-app-projects.md.
LANGFUSE_ORG_PUBLIC_KEY=pk-lf-org-...
LANGFUSE_ORG_SECRET_KEY=sk-lf-org-...
# Encrypts each app's provisioned secret key at rest (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset -> secrets are stored in plaintext (dev only). Do NOT rotate this after
# apps are provisioned, or their stored secret keys become undecryptable.
ENCRYPTION_KEY=

# LiteLLM egress providers. onprem (vLLM) uses a dummy key; cloud providers
# read standard LiteLLM env. Only needed when that provider is enabled.
SP_ONPREM_API_KEY=sk-noauth

# Deployment ceiling for the per-app pii_detection override (docs/reference/per-app-config.md).
# true (default) lets an app set pii_detection: off|regex; false locks every app on
# this deployment to the global detector (e.g. a hospital deployment).
SP_ALLOW_APP_PII_DOWNGRADE=true

# HMAC key for derived session ids (server.derive_session_id). Optional: any
# long random string; set the same value on every api replica so derived
# session ids stay stable across replicas and restarts. Unset -> a random
# per-process key (ids reset on restart, differ across replicas).
# SP_SESSION_ID_KEY=

# Level of RouteForge's own `serving.*` log lines, written one per line to stderr
# (`<time> <LEVEL> <logger> <message>`; structured lines carry JSON in the
# message). DEBUG | INFO | WARNING | ERROR; default INFO; an unknown value falls
# back to INFO with a warning. Root and third-party loggers (litellm) are not
# affected. See app/obs/log_config.py.
# SP_LOG_LEVEL=INFO

AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_KEY=
AZURE_API_VERSION=2024-06-01
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# tools/orchestrate — offline CLI hook that triggers/tracks an EXTERNAL
# training/distillation job (never run in-process; see CLAUDE.md rule 4).
# Only needed when running `python -m tools.orchestrate.trigger` / `.status`.
TRAINING_ORCHESTRATOR_URL=https://your-training-orchestrator.example.com
TRAINING_ORCHESTRATOR_TOKEN=

# Published model metrics (Artificial Analysis). OPTIONAL and admin-triggered only:
# RouteForge never calls AA on the request path. Leave both unset on air-gapped
# sites and use `scripts/aa_fetch.py` on a connected machine + Import in the console.
# SP_EXTERNAL_FETCH=off disables the Refresh button even when a key is set.
AA_API_KEY=
SP_EXTERNAL_FETCH=

# --- Admin console login ------------------------------------------------------
# The api seeds one admin at first boot (only if no admin with this email exists;
# changing the password later does not update a stored admin). Unset => the dev
# defaults admin@routeforge.local / changeme -- override for anything real.
# ADMIN_EMAIL=admin@routeforge.local
# ADMIN_PASSWORD=

# Port the api binds and probes (default 8080; the Dockerfile CMD and chart honour it).
# SP_SERVER_PORT=8080

# Directory of same-named config files (serving/routing/policy/pricing.yaml) merged
# over config/ at boot, to add a cloud provider, pool entries and prices without
# carrying a full copy. The config lint runs on the merged result. See app/config/loader.py.
# SP_CONFIG_OVERLAY_DIR=

# Switch a provider on or off without editing serving.yaml: SP_PROVIDER_<NAME>_ENABLED
# for onprem | azure | bedrock, values on|off|true|false|1|0|yes.
# SP_PROVIDER_AZURE_ENABLED=false
