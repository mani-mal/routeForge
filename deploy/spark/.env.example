# deploy/spark/.env.example — copy to deploy/spark/.env before the first boot.
# .env is gitignored; never commit real values.
#
#   cp deploy/spark/.env.example deploy/spark/.env
#
# Compose reads the .env sitting next to the FIRST -f file, i.e. this directory.

# --- required (compose refuses to start without them) ------------------------
ADMIN_PASSWORD=changeme-before-first-boot
POSTGRES_PASSWORD=changeme-too

# --- admin console -----------------------------------------------------------
ADMIN_EMAIL=admin@routeforge.local

# --- host / ports ------------------------------------------------------------
# Hostname or IP of the Spark as reached from YOUR browser. Only used to build
# the Langfuse deep-link; leave as localhost if you browse on the Spark itself.
SPARK_HOST=localhost
API_PORT=8080
UI_PORT=3001

# Host address the api/ui ports publish on. Naming 0.0.0.0 EXPLICITLY matters:
# with the host address omitted, Docker also binds [::], which on a machine with
# a globally routable IPv6 address puts the console and the admin API straight
# on the public internet (subject only to the upstream router's firewall).
# Set to 127.0.0.1 for loopback-only, and reach the console over an SSH tunnel.
BIND_ADDR=0.0.0.0
LANGFUSE_PORT=3000

# --- router behaviour --------------------------------------------------------
# regex | presidio | off. presidio requires API_EXTRAS to include `presidio`
# (the image build then downloads the en_core_web_lg spaCy model).
SP_PII_DETECTION=regex
API_EXTRAS=observability,postgres
# API_EXTRAS=observability,postgres,presidio

# Bearer token routeForge sends to onboarded on-prem endpoints. A vLLM or ollama
# server started without an API key ignores it.
SP_ONPREM_API_KEY=sk-noauth

# --- Langfuse (only used with the docker-compose.langfuse.yml overlay) --------
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# HMAC key for derived session ids (server.derive_session_id). Optional: any
# long random string; set the same value on every api replica so derived
# session ids stay stable across replicas and restarts. Unset -> a random
# per-process key (ids reset on restart, differ across replicas).
# SP_SESSION_ID_KEY=

# Level of RouteForge's own `serving.*` log lines, written one per line to stderr
# (`<time> <LEVEL> <logger> <message>`; structured lines carry JSON in the
# message). DEBUG | INFO | WARNING | ERROR; default INFO; an unknown value falls
# back to INFO with a warning. Root and third-party loggers (litellm) are not
# affected. See app/obs/log_config.py.
# SP_LOG_LEVEL=INFO
