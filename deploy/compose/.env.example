# Serving Plane compose overrides — copy to .env and edit. NEVER commit .env.
# All values below have working defaults baked into docker-compose.yml; this
# file just documents what you can override without editing the compose file.

# --- PII detection -----------------------------------------------------------
# regex (offline-safe) | presidio (needs a spaCy model download) | off
SP_PII_DETECTION=regex

# --- Headroom compression ----------------------------------------------------
# on | off  (leave unset to follow config/serving.yaml default of off)
# SP_CONTEXT_OPT=off

# --- Langfuse (self-hosted in this stack) ------------------------------------
# These match the langfuse.yml init project; change only if you rotate keys.
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# --- Optional --------------------------------------------------------------
# HMAC key for derived session ids (same value on every replica). Unset => a
# random per-process key.
# SP_SESSION_ID_KEY=

# Level of the serving.* log lines: DEBUG | INFO | WARNING | ERROR (default INFO).
# SP_LOG_LEVEL=INFO

# Multi-tenant store. Unset => in-container SQLite. To use this stack's Postgres
# you must ALSO build the api image with the postgres extra (asyncpg): set
# EXTRAS to "observability,postgres" in docker-compose.yml. Then:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/postgres
